{
  "name": "PROOF X-Ray — Autonomous International Enterprise (EAI) Standard",
  "version": "2.0.0",
  "protocol": "proof-vc-v2",
  "description": "Open specification, offline-verifiable Ed25519 public certificate API (PROOF-VC v2), and deterministic SEO/GEO verification tooling for AI agents.",
  "url": "https://www.proofxray.com",
  "authority": {
    "organization": "PROOF X-Ray (Arthur Mellin EI — SIRET 509 969 622 00067)",
    "founder": "Arthur Mellin",
    "country": "FR",
    "protocol": "Autonomous International Enterprise (EAI) v1.0 / PROOF-VC v2",
    "specification": "https://github.com/monsieureka/autonomous-enterprise-standard"
  },
  "endpoints": {
    "public_certificate": {
      "url": "https://www.proofxray.com/api/public/v1/certificate",
      "method": "GET",
      "parameters": {
        "domain": {
          "type": "string",
          "description": "Target domain to inspect (e.g. proofxray.com)"
        }
      },
      "signature": "Ed25519 (JCS RFC 8785) + SHA-256 Merkle claimRoot",
      "jwks": "https://www.proofxray.com/.well-known/jwks.json",
      "response_format": "application/json"
    },
    "jwks": {
      "url": "https://www.proofxray.com/.well-known/jwks.json",
      "method": "GET",
      "format": "application/json"
    },
    "dynamic_badge": {
      "url": "https://www.proofxray.com/api/badge?domain=proofxray.com",
      "method": "GET",
      "output": "image/svg+xml"
    },
    "llm_index": {
      "url": "https://www.proofxray.com/llms.txt",
      "method": "GET",
      "format": "text/markdown"
    }
  },
  "dns_ownership_draft": {
    "status": "RFC Draft",
    "txt_record_prefix": "_proof-verify",
    "specification": "https://github.com/monsieureka/autonomous-enterprise-standard/blob/main/schema/dns-handshake.md"
  },
  "references": {
    "proofVcSpecFr": "https://www.proofxray.com/proof-vc",
    "proofVcSpecEn": "https://www.proofxray.com/en/proof-vc",
    "devtoProfile": "https://dev.to/proofxray",
    "devtoArticle": "https://dev.to/proofxray/how-i-built-a-cryptographically-verifiable-seo-ai-readiness-geo-standard-with-ed25519-dns-01-412c",
    "devtoArticle2": "https://dev.to/proofxray/why-js-rendered-smb-hotel-sites-score-57-66100-in-raw-html-and-how-we-reached-79-85-with-zero-3ci9",
    "devtoArticle3": "https://dev.to/proofxray/checking-ai-readiness-signals-across-big-ai-companies-own-sites-a-10-minute-audit-1pfd"
  }
}
